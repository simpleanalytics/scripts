{
  "name": "scripts",
  "version": "9.0.0",
  "private": true,
  "description": "Simple Analytics visitor facing scripts",
  "main": "compile.js",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=24.12.0 <25",
    "pnpm": ">=11.17.0 <12"
  },
  "scripts": {
    "playground": "./playground.sh",
    "watch": "nodemon compile.js --ignore dist",
    "build": "node compile.js",
    "build:testing": "node compile.js testing",
    "deploy": "node --env-file-if-exists=.env deploy.mts",
    "pretest": "pnpm run build:testing",
    "test": "node -r dotenv/config ./test/index.js",
    "test:matrix": "mocha test/helpers/get-browsers.test.js",
    "test:unit": "mocha 'test/unit/*.test.js'",
    "test:deploy": "node --test test/deploy.test.mts",
    "posttest": "pnpm run build",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/simpleanalytics/scripts.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/simpleanalytics/scripts/issues"
  },
  "homepage": "https://github.com/simpleanalytics/scripts#readme",
  "dependencies": {
    "@clack/prompts": "1.7.0"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "acorn": "^8.18.0",
    "browserstack-local": "^1.5.14",
    "chai": "^4.5.0",
    "dotenv": "^8.2.0",
    "eslint": "^8.57.1",
    "esprima": "^4.0.1",
    "handlebars": "^4.7.9",
    "jsdom": "^26.1.0",
    "mocha": "^12.0.2",
    "nodemon": "^3.1.14",
    "selenium-webdriver": "4.3.1",
    "typescript": "7.0.2",
    "uglify-js": "^3.9.4",
    "uuid-validate": "0.0.3"
  }
}
